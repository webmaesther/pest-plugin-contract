{
    "name": "webmaesther/pest-plugin-contract",
    "description": "Pest plugin to define contract tests",
    "keywords": [
        "php",
        "framework",
        "pest",
        "unit",
        "test",
        "testing",
        "plugin"
    ],
    "authors": [
        {
            "name": "Eszter Czotter",
            "email": "eszter.czotter@gmail.com",
            "homepage": "https://eszter.czotter.me",
            "role": "Developer"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "pestphp/pest": "^4.0.0",
        "pestphp/pest-plugin": "^4.0.0"
    },
    "autoload": {
        "psr-4": {
            "Pest\\Contract\\": "src/"
        },
        "files": [
            "src/Autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "pestphp/pest-dev-tools": "^4.0.0",
        "pestphp/pest-plugin-faker": "^4.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "refacto": "rector",
        "lint": "pint",
        "test:refacto": "rector --dry-run",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --ansi",
        "test:unit": "pest --colors=always --exclude-group=playground",
        "test:playground": "pest --colors=always --group=playground",
        "test": [
            "@test:refacto",
            "@test:lint",
            "@test:types",
            "@test:unit",
            "@test:playground"
        ]
    },
    "extra": {
        "pest": {
            "plugins": [
                "Pest\\Contract\\Plugin"
            ]
        }
    }
}
